    def __init__(self, anotherAnim: AnimInfo) -> None: ...
    mAnimType : AnimType
    mFrameDelay : int
    mFrameMap : List_1[int]
    mNumCels : int
    mPerFrameDelay : List_1[int]
    mTotalAnimTime : int
    def Dispose(self) -> None: ...
    def GetCel(self, theTime: int) -> int: ...
    def GetPerFrameCel(self, theTime: int) -> int: ...
    def SetPerFrameDelay(self, theFrame: int, theTime: int) -> None: ...
    # Skipped Compute due to it being static, abstract and generic.

    Compute : Compute_MethodGroup
    class Compute_MethodGroup:
        @typing.overload
        def __call__(self, theNumCels: int) -> None:...
        @typing.overload
        def __call__(self, theNumCels: int, theBeginFrameTime: int) -> None:...
        @typing.overload
        def __call__(self, theNumCels: int, theBeginFrameTime: int, theEndFrameTime: int) -> None:...



